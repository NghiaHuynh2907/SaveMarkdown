{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Password": ""
  },
  "Storage": {
    "RootPath": "data"
  },
  "Backup": {
    "Enabled": true,
    "Directory": "backups",
    "IntervalHours": 24,
    "Keep": 14
  }
}
